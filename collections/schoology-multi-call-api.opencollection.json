{
  "opencollection": "1.0.0",
  "info": {
    "name": "Schoology REST API v1 Assignments Multi-Call API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.schoology.com/v1/oauth/authorize",
      "accessTokenUrl": "https://api.schoology.com/v1/oauth/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Multi-Call",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Multi-call GET",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.schoology.com/v1/multiget"
          },
          "docs": "Multi-call GET"
        },
        {
          "info": {
            "name": "Multi-call OPTIONS",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.schoology.com/v1/multioptions"
          },
          "docs": "Multi-call OPTIONS"
        }
      ]
    }
  ],
  "bundled": true
}