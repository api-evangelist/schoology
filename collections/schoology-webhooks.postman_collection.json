  "info": {
    "_postman_id": "c9db4cea-fac7-432b-8923-65405ab7028d",
    "name": "Schoology Event Triggers (Webhooks) API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Schoology's documented webhook surface, called \"Event Triggers\". Schoology-defined\nactions (\"triggers\") fire against user-defined HTTP endpoints (\"targets\") that are\nlinked via \"subscriptions\". Schoology POSTs event objects to the configured target\nURL and expects an HTTP 200 response. If a non-200 is received, the event is\nrequeued and retried up to 5 times at 10 minute intervals, after which it is\ndropped.\nSource: https://developers.schoology.com/api-documentation/rest-api-triggers-v1/\nEvent objects: https://developers.schoology.com/api-documentation/rest-api-triggers-v1/event_objects/\n",
      "type": "text/plain"
    }
  }
